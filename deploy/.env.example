# Plantilla del .env que el workflow de deploy genera EN el servidor a partir de los
# GitHub Secrets. No se versiona el .env real.
NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/coche.db

# Dominio público de la API (Caddy pide el certificado para él).
API_DOMAIN=api.corentingcar.uk
BASE_URL=https://api.corentingcar.uk

# Orígenes permitidos por CORS (la app móvil no envía Origin; útil si hay web/admin).
CORS_ORIGINS=https://corentingcar.uk

# Secreto de sesión (largo y aleatorio). OBLIGATORIO en producción.
SESSION_TOKEN_SECRET=cambia-esto-por-un-secreto-largo

# PIN iniciales (solo se usan en el PRIMER seed, BD vacía).
ANDY_PIN=1234
AMIGO_PIN=5678

# Fecha ancla de la alternancia de prioridad (opcional).
ANCHOR_DATE=2025-01-01

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (en producción apuntar a un volumen, p.ej. /data/coche.db)
DATABASE_PATH=./data/coche.db

# Orígenes permitidos por CORS (separados por comas). Usa * solo en desarrollo.
CORS_ORIGINS=*

# URL base pública del backend
BASE_URL=http://localhost:3000

# Secreto para tokens de sesión (OBLIGATORIO cambiarlo en producción)
SESSION_TOKEN_SECRET=dev-secret-change-me
